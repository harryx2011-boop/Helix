# Helix configuration
#
# Two distinct kinds of credential live here:
#
#   1. Helix's own settings  — ports, database, service URLs
#   2. YOUR provider keys    — LLM, embedding, proxy, vector store
#
# Helix calls your models with your keys. Your provider bills you directly.
# Nothing here is ever sent to a Helix-operated service.

# ---------------------------------------------------------------- core

HELIX_PORT=7400
HELIX_LOG_LEVEL=info

# Bootstrap API key, created on first boot. Rotate it from the API afterwards.
# Generate one:  openssl rand -hex 32
HELIX_BOOTSTRAP_KEY=
# Shared secret for the hosted website's key sync (POST /internal/keys). Leave unset on a self-host.
HELIX_INTERNAL_ADMIN_TOKEN=

DATABASE_URL=postgres://helix:helix@localhost:7432/helix

HELIX_FETCH_URL=http://localhost:7401
HELIX_EXTRACT_URL=http://localhost:7402

# Upload ceiling for POST /v1/parse (uploaded or fetched file), in megabytes.
HELIX_PARSE_MAX_UPLOAD_MB=25

# Parses held in memory at once. Beyond this, /v1/parse answers 503 with
# Retry-After instead of buffering another file.
HELIX_PARSE_MAX_INFLIGHT=8

# ---------------------------------------------------------------- LLM (BYOK)
#
# Set whichever you use. Native adapters exist for OpenAI, Anthropic and Gemini;
# everything else (OpenRouter, Ollama, vLLM, LM Studio) goes through the
# OpenAI-compatible path.

HELIX_LLM_PROVIDER=openai
HELIX_LLM_MODEL=gpt-4o-mini

OPENAI_API_KEY=
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=

# Either name works for Gemini.
GEMINI_API_KEY=
GOOGLE_API_KEY=

OPENROUTER_API_KEY=

# OpenAI-compatible endpoints. Ollama example:
#   HELIX_LLM_PROVIDER=openai-compatible
#   OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
#   HELIX_LLM_MODEL=qwen2.5
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

# ---------------------------------------------------------------- embeddings
#
# Defaults to a local sentence-transformers model, so chunking and vector sync
# work with no keys and no cost. Set a provider to override.

HELIX_EMBEDDING_PROVIDER=local
HELIX_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# HELIX_EMBEDDING_PROVIDER=openai
# HELIX_EMBEDDING_MODEL=text-embedding-3-small

VOYAGE_API_KEY=
COHERE_API_KEY=

# ---------------------------------------------------------------- proxies (BYO)
#
# Helix ships no proxy pool. Supply your own provider's credentials, or leave
# blank to fetch directly. Per-request and per-domain overrides are available
# through the API.

HELIX_PROXY_URL=
HELIX_PROXY_SESSION_TTL=600

# ---------------------------------------------------------------- egress
#
# A caller chooses what this instance fetches. Loopback, link-local and
# private-range addresses (cloud metadata, Postgres, the internal services) are
# refused, including through redirects, unless this is set to true. Enable only
# for an instance that scrapes its own intranet and trusts every key it issues.

HELIX_ALLOW_PRIVATE_URLS=false

# ---------------------------------------------------------------- vector stores

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# pgvector reuses DATABASE_URL by default.
PGVECTOR_URL=

# ---------------------------------------------------------------- search
#
# /search needs a search backend. `auto` picks the first one with credentials:
# a self-hosted SearXNG instance (no key; enable `json` under search.formats in
# its settings.yml), then Serper, then SerpAPI. Serper is roughly 10-25x cheaper
# than SerpAPI at comparable volume. Set the provider explicitly to pin one.

HELIX_SEARCH_PROVIDER=auto
SEARXNG_URL=
SERPER_API_KEY=
SERPAPI_KEY=
# Ceiling on `limit`, pages read in parallel per call, the query-cache TTL, and
# the wall-clock budget for one call (pages not read in time carry a `timeout`
# failure; work stops when the caller disconnects).
HELIX_SEARCH_MAX_RESULTS=50
HELIX_SEARCH_SCRAPE_CONCURRENCY=5
HELIX_SEARCH_CACHE_TTL_MS=60000
HELIX_SEARCH_MAX_DURATION_MS=120000

# ---------------------------------------------------------------- browser

HELIX_BROWSER_POOL_SIZE=4
HELIX_BROWSER_MAX_CONTEXTS=20
# Recycle a browser process after this many pages, to bound memory growth.
HELIX_BROWSER_RECYCLE_AFTER=250
HELIX_LIGHTPANDA_ENABLED=false
HELIX_LIGHTPANDA_URL=http://localhost:9222

# ---------------------------------------------------------------- crawling

HELIX_RESPECT_ROBOTS=true
HELIX_USER_AGENT=HelixBot/0.1 (+https://github.com/yourname/helix)
HELIX_DEFAULT_POLITENESS=adaptive
HELIX_MAX_HOST_CONCURRENCY=8
# Default page limit when a crawl request omits `limit`, and the hard ceilings
# a request cannot exceed. There is no billing layer to bound a runaway crawl.
HELIX_CRAWL_DEFAULT_LIMIT=1000
HELIX_CRAWL_MAX_LIMIT=100000
HELIX_CRAWL_MAX_DEPTH=50

# ---------------------------------------------------------------- webhooks
#
# Set a secret to sign deliveries (`Helix-Signature: t=<unix>,v1=<hex>`,
# HMAC-SHA256 over `{timestamp}.{body}`). Unsigned when empty.
HELIX_WEBHOOK_SECRET=
# Retries with exponential backoff (1 min doubling, capped at 6 h). 20 attempts
# spans about three days; after that the delivery is marked dead.
HELIX_WEBHOOK_MAX_ATTEMPTS=20

# ---------------------------------------------------------------- retention

HELIX_RESULT_TTL_HOURS=168
HELIX_CACHE_TTL_HOURS=24

# ---------------------------------------------------------------- dashboard
#
# Split-port: the dashboard runs on 3400, the API on 7400. The API allows the
# dashboard's origin through CORS; the dashboard bakes the API URL at build time.

HELIX_DASHBOARD_PORT=3400
HELIX_CORS_ORIGINS=http://localhost:3400,http://127.0.0.1:3400

# Where the API is reachable from the BROWSER (baked into the dashboard build).
NEXT_PUBLIC_HELIX_API_URL=http://localhost:7400
