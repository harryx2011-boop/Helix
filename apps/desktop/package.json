{
  "name": "@helix/desktop",
  "productName": "Helix",
  "version": "2.3.2",
  "private": true,
  "description": "Helix for Windows: scrape, parse, search, crawl, interact and monitor, on your own machine.",
  "license": "Apache-2.0",
  "author": "harryx2011-boop",
  "homepage": "https://github.com/harryx2011-boop/Helix",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "node ../../node_modules/typescript-native/bin/tsc --noEmit",
    "web": "node scripts/build.mjs && node out/launch.js",
    "web:ui": "node scripts/build-ui.mjs",
    "web:dev": "node scripts/build.mjs && node out/launch.js --ui-dev"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3"
