{
  "name": "@helix/desktop",
  "productName": "Helix",
  "version": "2.3.2",
  "private": true,
  "description": "Helix for Windows: scrape, parse, search, crawl, interact and monitor, on your own machine.",
  "license": "Apache-2.0",
  "author": "harryx2011-boop",
  "homepage": "https://github.com/harryx2011-boop/Helix",
  "main": "./out/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/dev.mjs",
    "icon": "node scripts/make-icon.mjs",
    "stage": "node scripts/stage.mjs",
    "package": "node scripts/build.mjs && node scripts/stage.mjs && electron-builder --win --x64",
    "test": "vitest run",
    "typecheck": "node ../../node_modules/typescript-native/bin/tsc --noEmit"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.9.0",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "png-to-ico": "^3.0.2",
    "typescript": "^5.6.3"
  }
}
