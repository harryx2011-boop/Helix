{
  "name": "helix",
  "version": "2.3.2",
  "private": true,
  "description": "A frontier utility hub. Self-hostable and BYOK.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @helix/api dev",
    "build": "pnpm -r build",
    "test": "node supabase/check-schema.mjs && pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "check:schema": "node supabase/check-schema.mjs",
    "codegen": "pnpm --filter @helix/schema codegen",
    "up": "docker compose up --build",
    "down": "docker compose down -v"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "typescript-native": "npm:typescript@^7"
  },
  "pnpm": {
    "overrides": {
      "body-parser@>=2 <2.4.0": "2.4.0",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=5 <5.0.12": "5.0.12",
      "fast-uri@>=3 <3.1.9": "3.1.9",
      "fast-uri@>=4 <4.2.3": "4.2.3",
      "hono@<4.13.11": "4.13.11",
      "ip-address@>=10 <10.7.4": "10.7.4",
      "js-yaml@>=4 <4.3.2": "4.3.2",
      "postcss@>=8 <8.5.23": "8.5.23",
      "proxy-addr@<2.0.8": "2.0.8",
      "qs@>=6 <6.16.0": "6.16.0",
      "source-map-js@<1.2.2": "1.2.2",
      "undici@>=6 <6.29.1": "6.29.1",
      "undici@>=7 <7.30.1": "7.30.1",
      "undici@>=8 <8.12.2": "8.12.2"
    }
  }
}
