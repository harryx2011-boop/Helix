{
  "name": "@helix/sdk",
  "version": "1.6.2",
  "description": "Typed client for Helix, a frontier utility hub.",
  "license": "Apache-2.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "generate": "npx tsx codegen/generate.ts",
    "check:generated": "npx tsx codegen/generate.ts --check"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "eslint": "^9.15.0"
  }
}
