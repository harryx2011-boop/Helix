{
  "name": "@helix/sdk",
  "version": "1.0.0",
  "description": "Typed client for the Helix web-data API.",
  "license": "Apache-2.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
