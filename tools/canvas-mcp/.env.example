# Your school's Canvas host. No /api/v1 suffix needed.
CANVAS_URL=https://yourschool.instructure.com

# Personal access token: Canvas > Account > Settings > Approved Integrations > New Access Token
CANVAS_TOKEN=

# Optional
CANVAS_TIMEOUT=30
CANVAS_CACHE_TTL=300
CANVAS_MAX_CONCURRENCY=5
CANVAS_DOWNLOAD_DIR=

# Student privacy: strict (default) | pseudonymize | off
# strict: students show as class-period labels (P3-07), names in free text are
# replaced, other emails/phones are redacted, raw student ids are hidden.
CANVAS_PRIVACY_MODE=strict
# Where the label crosswalk, key, audit log and private downloads live.
CANVAS_PRIVACY_DIR=
# Optional: supply the label key yourself (16+ chars) instead of the key file.
CANVAS_PRIVACY_KEY=
# Days to keep files in the private download folder.
CANVAS_RETENTION_DAYS=30
# Strict mode refuses tunnels (claude.ai) unless your school has approved one.
CANVAS_PRIVACY_ACK_TUNNEL=

# Only needed to reach the server over HTTP from outside this machine
# (Claude on the web). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CANVAS_MCP_AUTH_TOKEN=

# Hostnames a tunnel or reverse proxy puts in the Host header, comma separated.
# Setting this turns on Host/Origin validation.
CANVAS_MCP_ALLOWED_HOSTS=
